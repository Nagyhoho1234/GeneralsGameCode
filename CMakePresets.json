            "displayName": "Windows 32bit VC6 Release Logging",
            "inherits": "vc6",
            "cacheVariables": {
                "RTS_DEBUG_LOGGING": "ON",
                "RTS_DEBUG_CRASHING": "ON"
            }
        },
        {
