                "RTS_FLAGS": "/W3"
            },
            "vendor": {
                "jetbrains.com/clion": {
                    "toolchain": "Visual Studio 6"
                }
            }
        },
        {
            "name": "vc6-profile",
            "displayName": "Windows 32bit VC6 Profile",
