            "inherits": "vc6",
            "cacheVariables": {
                "RTS_BUILD_OPTION_PROFILE": "ON"
            }
        },
        {
            "name": "vc6-debug",
            "displayName": "Windows 32bit VC6 Debug",
            "hidden": false,
            "inherits": "vc6",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "RTS_BUILD_OPTION_DEBUG": "ON"
            }
        },
        {
