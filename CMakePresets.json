        {
            "name": "linux-x64",
            "displayName": "Linux 64bit Release (native)",
            "description": "Native 64-bit Linux build with the system compiler directly, no vcpkg toolchain (native port plan Phase 1/2). Builds the currently-portable subset of the game (Core/GameEngine + Core/GameEngineDevice's non-D3D8/non-Win32 sources for both Generals and GeneralsMD) - the full game executable still needs Phase 3-7 (rendering/audio/windowing) before it links.",
            "generator": "Ninja",
            "hidden": false,
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "linux-x64-debug",
            "inherits": "linux-x64",
            "hidden": false,
            "displayName": "Linux 64bit Debug (native)",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "RTS_BUILD_OPTION_DEBUG": "ON"
            }
        },
        {
            "name": "macos-arm64",
            "displayName": "macOS 64bit Release (native, Apple Silicon)",
            "description": "Native macOS build with the system Clang toolchain directly, no vcpkg (native port plan Phase 1/2). Same portable subset as linux-x64. Advisory - the main game build has not yet been run against real Apple hardware for this preset (only the standalone native-port-spike graphics prototype has, in macos-native CI).",
            "generator": "Ninja",
            "hidden": false,
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_OSX_ARCHITECTURES": "arm64"
            }
        },
        {
